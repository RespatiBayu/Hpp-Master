# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Postgres database for the Express backend
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/hpp_master"

# Backend server port
PORT="4000"

# APP_URL: The URL where this applet is hosted.
# Used for cookies, redirects, and self-referential links.
APP_URL="http://localhost:3000"

# Session settings
SESSION_COOKIE_NAME="hpp_session"
SESSION_TTL_DAYS="14"

# Auto-create/update tables on backend startup
AUTO_MIGRATE="true"
