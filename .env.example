# fal.ai API key for the floating assistant bot.
FAL_KEY="YOUR_FAL_API_KEY"

# Free-tier model routing for AI intake.
AI_TEXT_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
AI_VISION_MODEL="google/gemini-2.0-flash-exp:free"
AI_FREE_FALLBACK_MODEL="openrouter/free"

# Telegram integration for AI intake drafts.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Postgres database for the Express backend
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/hpp_master"

# Backend server port
PORT="4000"

# APP_URL: The URL where this applet is hosted.
# Used for cookies, redirects, and self-referential links.
APP_URL="http://localhost:3000"

# Session settings
SESSION_COOKIE_NAME="hpp_session"
SESSION_TTL_DAYS="14"

# Auto-create/update tables on backend startup
AUTO_MIGRATE="true"
